<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The window loads http://127.0.0.1:<port>, which is a network client
         request. Under the hardened runtime it is declared here so the
         notarized app keeps working the same way the ad-hoc one did. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
